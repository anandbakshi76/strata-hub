{
  "name": "strata-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scroll-driven launch page for Strata, a fictional modular smart home hub.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run types && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "gsap": "^3.15.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@playwright/test": "^1.65.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
