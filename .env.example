# Names of the secrets and settings this project needs, with no values.
# Copy this file to .env and fill in the values there. .env is never committed.

# Observability: see docs/OBSERVABILITY.md
# TRACE_BACKEND is local, langfuse or langsmith
TRACE_BACKEND=local
# true only while developing, never with real personal data
LOG_CONTENT=false
TRACE_SAMPLE_RATE=1.0
TRACE_DIR=logs/traces
